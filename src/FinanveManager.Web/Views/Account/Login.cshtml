@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0E2A28" />
    <title>Авторизация — СтройФинРиск</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-shell">
    <section class="login-brand">
        <div class="login-logo">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18"/>
                    <path d="M5 21V8l6-4 6 4v13"/>
                    <path d="M9 21v-4h4v4"/>
                    <path d="M9 10h.01M13 10h.01"/>
                </svg>
            </div>
            <div>
                <h1>СтройФинРиск</h1>
                <div class="brand-tag">Finance &amp; Risk Analyst</div>
            </div>
        </div>

        <p class="lead">
            Сетевое программное средство управления финансами проектов
            и анализа рисков строительной компании.
        </p>

        <ul class="login-features">
            <li>
                <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                Контроль свободного лимита L<sub>дост</sub> = B − O и платёжной дисциплины
            </li>
            <li>
                <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                Матрица рисков 5×5 и портфельный резерв P80
            </li>
            <li>
                <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                Разграничение прав по 7 ролям и журнал аудита
            </li>
        </ul>

        <div class="login-brand-footer">
            Веб-клиент предназначен для оперативного контура:
            <strong>финансовый менеджер</strong>, <strong>руководитель проекта</strong>
            и <strong>специалист по рискам</strong>.
        </div>
    </section>

    <section class="login-card">
        <h2>Вход в систему</h2>
        <p class="login-sub">Интерфейс и доступные разделы настраиваются под вашу роль автоматически.</p>

        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert alert-success">@Model.InfoMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" asp-controller="Account" asp-action="Login">
            <div class="field">
                <label for="Login">Логин</label>
                <input id="Login" name="Login" value="@Model.Login" autocomplete="username" placeholder="Введите логин" required />
            </div>
            <div class="field">
                <label for="Password">Пароль</label>
                <input id="Password" name="Password" type="password" value="@Model.Password" autocomplete="current-password" placeholder="Введите пароль" required />
            </div>
            @if (Model.RequiresTwoFactor)
            {
                <div class="field">
                    <label for="TwoFactorCode">Код двухфакторной аутентификации</label>
                    <input id="TwoFactorCode" name="TwoFactorCode" value="@Model.TwoFactorCode" placeholder="6-значный код" />
                </div>
            }
            <button type="submit" class="btn">Войти в систему</button>
        </form>

        <div class="login-meta">
            База данных MS SQL Server: <code>@(string.IsNullOrEmpty(Model.DatabaseName) ? "FinanveManagerDb" : Model.DatabaseName)</code><br />
            Демонстрационный пароль: <code>StroyFin2026!</code>
        </div>

        @if (!Model.HasUsers)
        {
            <div class="divider"></div>
            <h3 class="card-title" style="margin-bottom:6px">База данных пуста</h3>
            <p class="muted" style="margin-top:0">
                Структура таблиц создана, но учётные записи отсутствуют. Выполните
                <code>database/02_seed_data.sql</code> или выберите способ инициализации:
            </p>
            <form method="post" asp-controller="Account" asp-action="InitializeRolesAndAdmin" style="margin-bottom:9px">
                <button type="submit" class="btn btn-outline" style="width:100%">
                    Создать 7 ролей, admin и director без демо-проектов
                </button>
            </form>
            <form method="post" asp-controller="Account" asp-action="InitializeDemoData">
                <button type="submit" class="btn btn-success" style="width:100%">
                    Загрузить контрольные примеры главы 1
                </button>
            </form>
        }
        else
        {
            <div class="divider"></div>
            <h3 class="card-title" style="margin-bottom:4px">Демонстрационные роли</h3>
            <p class="muted" style="margin-top:0">Нажмите на карточку, чтобы подставить логин и пароль.</p>
            @if (!Model.DemoUsers.Any())
            {
                <div class="alert alert-info">
                    В базе нет активных веб-пользователей. Создайте их через WPF-клиент администратора
                    (<code>admin</code>) или выполните <code>database/02_seed_data.sql</code>.
                </div>
            }
            else
            {
                <div class="demo-grid">
                    @foreach (var u in Model.DemoUsers)
                    {
                        <button type="button" class="demo-btn" onclick="fillLogin('@u.Login')">
                            <div style="font-weight:700;font-size:12.5px">@u.RoleName</div>
                            <div class="muted" style="margin-top:2px">@u.FullName</div>
                            <div style="margin-top:6px;font-size:11px">
                                <code>@u.Login</code> · <span class="badge badge-info">@u.RoleCode</span>
                            </div>
                        </button>
                    }
                </div>
            }
            <p class="login-note">
                Остальные роли — руководитель организации, бухгалтер, специалист по снабжению
                и администратор — работают в настольном WPF-клиенте.
            </p>
        }
    </section>
</main>
<script>
    function fillLogin(login) {
        document.getElementById('Login').value = login;
        document.getElementById('Password').value = 'StroyFin2026!';
        document.getElementById('Password').focus();
    }
</script>
</body>
</html>
