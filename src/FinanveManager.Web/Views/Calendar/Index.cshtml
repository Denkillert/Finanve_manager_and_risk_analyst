@model CalendarViewModel
@{
    ViewData["Title"] = "Платёжный календарь";
    ViewData["Subtitle"] = "Прогноз остатка средств и кассовых разрывов на горизонте";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    int horizonDays = ViewBag.HorizonDays is int h ? h : 90;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Параметры прогноза (формулы 1.8–1.9: C(t) = C(t−1) + P(t) − V(t), Разрыв = max(0, Cmin − C(t)))</h3>
        <form method="get" asp-controller="Calendar" asp-action="Index" class="inline-form">
            <select name="projectId" style="padding:5px 8px;border:1px solid #cbd5e1;border-radius:6px">
                <option value="" selected="@(!Model.SelectedProjectId.HasValue)">Все проекты (портфель)</option>
                @foreach (var p in Model.Projects)
                {
                    <option value="@p.Id" selected="@(Model.SelectedProjectId == p.Id)">@p.Code — @p.Name</option>
                }
            </select>
            <select name="horizonDays" style="padding:5px 8px;border:1px solid #cbd5e1;border-radius:6px">
                <option value="5" selected="@(horizonDays == 5)">5 дней (табл. 1.5)</option>
                <option value="30" selected="@(horizonDays == 30)">30 дней</option>
                <option value="90" selected="@(horizonDays == 90)">90 дней (Т-12)</option>
            </select>
            <button type="submit" class="btn btn-sm">Обновить расчёт</button>
        </form>
    </div>

    <div class="kpi-grid" style="margin-bottom:0">
        <div class="kpi-card">
            <div class="kpi-top">
                <div class="kpi-label">Начальный остаток C(0)</div>
                <div class="kpi-icon blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.4"/><path d="M2.5 10h19"/><path d="M7 15h3"/></svg>
                </div>
            </div>
            <div class="kpi-value">@Model.InitialCash.ToString("N2") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top">
                <div class="kpi-label">Неснижаемый минимум Cmin</div>
                <div class="kpi-icon violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18V6"/><path d="M4 18h16"/><path d="M8 15l3.5-4 3 2.5L20 7"/></svg>
                </div>
            </div>
            <div class="kpi-value">@Model.MinCashBalance.ToString("N2") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top">
                <div class="kpi-label">Дней с кассовым разрывом</div>
                <div class="kpi-icon @(Model.GapDaysCount > 0 ? "red" : "green")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2.4"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M12 14v3M12 20h.01"/></svg>
                </div>
            </div>
            <div class="kpi-value @(Model.GapDaysCount > 0 ? "red" : "green")">@Model.GapDaysCount</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top">
                <div class="kpi-label">Максимальный кассовый разрыв</div>
                <div class="kpi-icon @(Model.MaxCashGap > 0 ? "red" : "green")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="m19 9-7 7-7-7"/></svg>
                </div>
            </div>
            <div class="kpi-value @(Model.MaxCashGap > 0 ? "red" : "green")">@Model.MaxCashGap.ToString("N2") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        </div>
    </div>
</div>

@if (Model.Days.Count > 1)
{
    var days = Model.Days;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    const decimal cw = 900m;
    const decimal chh = 210m;
    const decimal cPad = 30m;
    decimal minC = Math.Min(days.Min(d => d.ClosingBalance), Model.MinCashBalance);
    decimal maxC = Math.Max(days.Max(d => d.ClosingBalance), Model.MinCashBalance);
    if (maxC - minC < 1m) maxC = minC + 1m;
    decimal X(int i) => cPad + (cw - 2 * cPad) * i / Math.Max(1, days.Count - 1);
    decimal Y(decimal v) => chh - cPad - (chh - 2 * cPad) * (v - minC) / (maxC - minC);
    var points = string.Join(" ", days.Select((d, i) =>
        X(i).ToString("0.##", inv) + "," + Y(d.ClosingBalance).ToString("0.##", inv)));
    var area = cPad.ToString("0.##", inv) + "," + (chh - cPad).ToString("0.##", inv) + " "
        + points + " " + (cw - cPad).ToString("0.##", inv) + "," + (chh - cPad).ToString("0.##", inv);
    int minIdx = days.Select((d, i) => (d, i)).OrderBy(t => t.d.ClosingBalance).First().i;
    var minDate = days[minIdx].Date;
    var minValue = days[minIdx].ClosingBalance;

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Баланс денежных средств, @horizonDays дн. горизонта</h3>
            <div class="card-actions">
                <div class="tabs">
                    @foreach (var hz in new[] { 90, 30, 5 })
                    {
                        <a class="tab @(horizonDays == hz ? "active" : "")"
                           asp-controller="Calendar" asp-action="Index"
                           asp-route-projectId="@Model.SelectedProjectId"
                           asp-route-horizonDays="@hz">@hz дней</a>
                    }
                </div>
            </div>
        </div>
        <div class="chart-box">
            <svg viewBox="0 0 900 210" preserveAspectRatio="none" role="img"
                 aria-label="Прогноз остатка денежных средств на @days.Count дней">
                <defs>
                    <linearGradient id="cashArea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.28"/>
                        <stop offset="100%" stop-color="#14b8a6" stop-opacity="0"/>
                    </linearGradient>
                </defs>
                @foreach (var f in new[] { 0.25m, 0.5m, 0.75m })
                {
                    var gy = ((chh - 2 * cPad) * f + cPad).ToString("0.##", inv);
                    <line x1="@cPad.ToString("0.##", inv)" x2="@((cw - cPad).ToString("0.##", inv))"
                          y1="@gy" y2="@gy" stroke="#eef3f1" stroke-width="1"/>
                }
                <line x1="@cPad.ToString("0.##", inv)" x2="@((cw - cPad).ToString("0.##", inv))"
                      y1="@Y(Model.MinCashBalance).ToString("0.##", inv)"
                      y2="@Y(Model.MinCashBalance).ToString("0.##", inv)"
                      stroke="#c2413b" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.7"/>
                <polygon points="@area" fill="url(#cashArea)"/>
                <polyline points="@points" fill="none" stroke="#0e7c66" stroke-width="2"
                          stroke-linejoin="round" stroke-linecap="round"/>
                <circle cx="@X(minIdx).ToString("0.##", inv)" cy="@Y(minValue).ToString("0.##", inv)"
                        r="4" fill="#c2413b" stroke="#fff" stroke-width="2"/>
                <text x="@cPad.ToString("0.##", inv)" y="@((chh - 8).ToString("0.##", inv))"
                      font-size="10" fill="#94a19e">@(days[0].Date.ToString("dd.MM.yyyy"))</text>
                <text x="@((cw - cPad).ToString("0.##", inv))" y="@((chh - 8).ToString("0.##", inv))"
                      font-size="10" fill="#94a19e" text-anchor="end">@(days[days.Count - 1].Date.ToString("dd.MM.yyyy"))</text>
            </svg>
        </div>
        <div class="legend">
            <span><i style="background:#0e7c66"></i>Остаток C(t)</span>
            <span><i style="background:#c2413b"></i>Неснижаемый минимум Cmin = @Model.MinCashBalance.ToString("N2") тыс. р.</span>
            <span><i style="background:#c2413b;opacity:.6"></i>Минимум: @minValue.ToString("N2") тыс. р. (@minDate.ToString("dd.MM.yyyy"))</span>
            <span style="margin-left:auto;color:var(--muted-2)">Разрыв = max(0, Cmin − C(t))</span>
        </div>
    </div>
}

@if (Model.OverdueCustomerItems.Any())
{
    <div class="alert alert-warn">
        <span class="alert-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
        </span>
        <span>
            <strong>Риск R-08 (просроченная дебиторская задолженность заказчика &gt; 10 дней):</strong>
            @foreach (var oc in Model.OverdueCustomerItems)
            {
                <span>@oc.Description (@oc.Amount.ToString("N0") тыс. р., срок @oc.PlannedDate.ToString("dd.MM.yyyy")); </span>
            }
        </span>
    </div>
}

<div class="grid-2 grid-stack">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Поденный график остатка средств (@Model.Days.Count записей)</h3>
        </div>
        <div class="table-wrap" style="max-height:520px;overflow-y:auto">
            <table>
                <thead>
                    <tr>
                        <th>День</th>
                        <th>Дата</th>
                        <th class="num">Нач. остаток</th>
                        <th class="num">Поступления P</th>
                        <th class="num">Выплаты V</th>
                        <th class="num">Кон. остаток C(t)</th>
                        <th class="num">Разрыв</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Days.Where(x => x.DayIndex <= 10 || x.Inflows > 0 || x.Outflows > 0 || x.CashGap > 0))
                    {
                        <tr style="background:@(d.CashGap > 0 ? "#fef4f4" : "transparent")">
                            <td>+@d.DayIndex</td>
                            <td>@d.Date.ToString("dd.MM.yyyy")</td>
                            <td class="num">@d.OpeningBalance.ToString("N2")</td>
                            <td class="num text-green">@(d.Inflows > 0 ? $"+{d.Inflows:N2}" : "0.00")</td>
                            <td class="num text-red">@(d.Outflows > 0 ? $"-{d.Outflows:N2}" : "0.00")</td>
                            <td class="num"><strong>@d.ClosingBalance.ToString("N2")</strong></td>
                            <td class="num">
                                @if (d.CashGap > 0)
                                {
                                    <span class="badge badge-danger">@d.CashGap.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="muted">0.00</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="margin-bottom:0">День 0 — начальный остаток на текущую дату; неоплаченные позиции со сроком сегодня или ранее включены в день 1. Показаны дни 0–10, а также все даты с движениями или кассовыми разрывами на горизонте @horizonDays дн. Позиции графиков и заявки учитываются отдельно: если они описывают один платёж, возможен двойной счёт.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Плановые позиции договоров (перенос даты платежа)</h3>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Позиция</th>
                        <th class="num">Сумма</th>
                        <th>Сдвиг срока</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.ScheduleItems)
                    {
                        <tr>
                            <td>@s.PlannedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @s.Description
                                <div>
                                    <span class="badge @(s.IsIncoming ? "badge-success" : "badge-warn")">
                                        @(s.IsIncoming ? "Поступление" : "Выплата")
                                    </span>
                                </div>
                            </td>
                            <td class="num"><strong>@s.Amount.ToString("N2")</strong></td>
                            <td>
                                @if (roleCode is "FinancialManager" or "CEO")
                                {
                                    <form method="post" asp-controller="Calendar" asp-action="Reschedule" class="inline-form">
                                        <input type="hidden" name="scheduleItemId" value="@s.Id" />
                                        <input type="hidden" name="projectId" value="@Model.SelectedProjectId" />
                                        <input type="hidden" name="horizonDays" value="@horizonDays" />
                                        <input type="date" name="newDate" value="@s.PlannedDate.ToString("yyyy-MM-dd")" style="padding:4px 6px" />
                                        <button type="submit" class="btn btn-outline btn-sm">Перенести</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
