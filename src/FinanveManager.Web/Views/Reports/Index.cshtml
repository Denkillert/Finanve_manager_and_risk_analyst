@model ReportGridModel
@{
    ViewData["Title"] = "Отчёты";
    ViewData["Subtitle"] = "Регламентные формы, печать и выгрузка в Excel";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var reports = roleCode == "RiskSpecialist"
        ? new (string Key, string Name)[]
        {
            ("risks-reserve-p80", "1. Реестр рисков и расчёт резерва P80")
        }
        : roleCode == "FinancialManager"
        ? new (string Key, string Name)[]
        {
            ("cash-flow-forecast", "1. Прогноз движения денежных средств"),
            ("budget-plan-fact", "2. План-факт исполнения бюджета"),
            ("contracts-advances", "3. Договоры и контроль выданных авансов"),
            ("payment-requests-violations", "4. Реестр заявок и нарушений лимитов")
        }
        : new (string Key, string Name)[]
        {
            ("ceo-portfolio-dashboard", "1. Сводный отчёт по портфелю"),
            ("ceo-liquidity", "2. Ликвидность и покрытие обязательств"),
            ("ceo-critical-risks", "3. Критические риски"),
            ("cash-flow-forecast", "4. Прогноз движения денежных средств"),
            ("budget-plan-fact", "5. План-факт исполнения бюджета"),
            ("project-evm-forecast", "6. Прогноз стоимости проектов (EVM + P80)"),
            ("contracts-advances", "7. Договоры и контроль выданных авансов"),
            ("payment-requests-violations", "8. Реестр заявок и нарушений лимитов")
        };
}

<div class="card">
    <div class="card-header">
        <div class="inline-form">
            @foreach (var r in reports)
            {
                <a class="btn btn-sm @(Model.ReportType == r.Key ? "" : "btn-outline")"
                   asp-controller="Reports" asp-action="Index" asp-route-reportType="@r.Key">@r.Name</a>
            }
        </div>
        <div class="inline-form">
            <a class="btn btn-success btn-sm" asp-controller="Reports" asp-action="ExportXlsx" asp-route-reportType="@Model.ReportType">Скачать Excel (.xlsx)</a>
            <a class="btn btn-outline btn-sm" asp-controller="Reports" asp-action="ExportCsv" asp-route-reportType="@Model.ReportType">CSV для обмена</a>
            <a class="btn btn-outline btn-sm" target="_blank" asp-controller="Reports" asp-action="Print" asp-route-reportType="@Model.ReportType">Печать / PDF</a>
        </div>
    </div>

    <h3 style="margin:6px 0 2px">@Model.Title</h3>
    <p class="muted" style="margin-top:0">@Model.Subtitle</p>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    @foreach (var h in Model.Headers)
                    {
                        <th>@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
