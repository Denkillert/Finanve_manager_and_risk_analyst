@model DashboardViewModel
@{
    ViewData["Title"] = "Главная панель";
    ViewData["Subtitle"] = "Сводный контроль портфеля проектов, ликвидности и рисков";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var canSeeRisks = RolePermissions.CanAccess(roleCode, AppSection.RisksAndP80);
}

<div class="alert alert-info">
    <span class="alert-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
    </span>
    <span>
        Подключение БД: <strong>@Model.DatabaseProvider</strong> · Референсная дата: <strong>10.11.2026</strong> ·
        Курсы НБ РБ: USD = 3,25 BYN, EUR = 3,52 BYN, RUB(100) = 3,45 BYN.
    </span>
</div>

@if (!Model.Forecasts.Any())
{
    <div class="alert alert-info">
        <span class="alert-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
        </span>
        <span>В подключённой базе данных пока нет проектов. Добавьте организации/проекты в базе данных или загрузите контрольные примеры при входе.</span>
    </div>
}

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-top">
            <div class="kpi-label">Контрактная цена портфеля</div>
            <div class="kpi-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l6-4 6 4v13"/><path d="M9 21v-4h4v4"/></svg>
            </div>
        </div>
        <div class="kpi-value">@Model.TotalContractValue.ToString("N0") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        <div class="kpi-sub">Активных проектов: @Model.ProjectCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-top">
            <div class="kpi-label">Утверждённый бюджет (BAC / B)</div>
            <div class="kpi-icon violet">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.4"/><path d="M2.5 10h19"/><path d="M7 15h3"/></svg>
            </div>
        </div>
        <div class="kpi-value">@Model.TotalApprovedBudget.ToString("N0") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        <div class="kpi-sub">Обязательства O: @Model.TotalGrossObligations.ToString("N0") тыс. р.</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-top">
            <div class="kpi-label">Свободный лимит Lдост = B − O</div>
            <div class="kpi-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 6.5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
        </div>
        <div class="kpi-value @(Model.TotalFreeLimit < 0 ? "red" : "green")">@Model.TotalFreeLimit.ToString("N2") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
        <div class="kpi-sub">Без двойного списания заявок Q</div>
    </div>
    @if (canSeeRisks)
    {
        <div class="kpi-card">
            <div class="kpi-top">
                <div class="kpi-label">Резерв рисков P80</div>
                <div class="kpi-icon amber">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="M12 8v4M12 16h.01"/></svg>
                </div>
            </div>
            <div class="kpi-value blue">@Model.TotalReserveP80.ToString("N2") <span style="font-size:13px;font-weight:600;color:var(--muted)">тыс. р.</span></div>
            <div class="kpi-sub">Квантиль z = 0,84 (ф-ла 1.18)</div>
        </div>
    }
    <div class="kpi-card">
        <div class="kpi-top">
            <div class="kpi-label">Кассовые разрывы (90 дн.)</div>
            <div class="kpi-icon @(Model.GapDaysCount90d > 0 ? "red" : "green")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 4 4 8-8"/><path d="M15 8h5v5"/></svg>
            </div>
        </div>
        <div class="kpi-value @(Model.GapDaysCount90d > 0 ? "red" : "green")">
            @(Model.GapDaysCount90d > 0 ? $"{Model.MaxCashGap90d:N0} тыс. р." : "Нет")
        </div>
        <div class="kpi-sub">Дней с дефицитом: @Model.GapDaysCount90d</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@(canSeeRisks ? "Прогноз стоимости проектов по освоенному объёму (EVM + резерв P80)" : "Финансовое исполнение и освоенный объём проектов (EVM)")</h3>
        @if (canSeeRisks)
        {
            <div class="card-actions">
                <a class="btn btn-sm" asp-controller="Risks" asp-action="Index">Матрица рисков 5×5 и P80</a>
            </div>
        }
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Код</th>
                    <th>Проект</th>
                    <th class="num">Цена V</th>
                    <th class="num">BAC</th>
                    <th class="num">PV / EV / AC</th>
                    <th class="num">CPI</th>
                    <th class="num">SPI</th>
                    <th class="num">EAC</th>
                    @if (canSeeRisks)
                    {
                        <th class="num">Резерв P80</th>
                        <th class="num">Фин. результат Rфин</th>
                    }
                    else
                    {
                        <th class="num">Маржа (V − EAC)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Forecasts)
                {
                    var cpiText = f.Forecast.Cpi.HasValue ? f.Forecast.Cpi.Value.ToString("N3") : "—";
                    var spiText = f.Forecast.Spi.HasValue ? f.Forecast.Spi.Value.ToString("N3") : "—";
                    <tr>
                        <td><strong>@f.Project.Code</strong></td>
                        <td>@f.Project.Name</td>
                        <td class="num">@f.Forecast.ContractValue.ToString("N0")</td>
                        <td class="num">@f.Forecast.Bac.ToString("N0")</td>
                        <td class="num">@f.Forecast.Pv.ToString("N0") / @f.Forecast.Ev.ToString("N0") / @f.Forecast.Ac.ToString("N0")</td>
                        <td class="num"><span class="badge @((f.Forecast.Cpi ?? 0m) >= 1m ? "badge-success" : "badge-warn")">@cpiText</span></td>
                        <td class="num"><span class="badge @((f.Forecast.Spi ?? 0m) >= 1m ? "badge-success" : "badge-warn")">@spiText</span></td>
                        <td class="num">@f.Forecast.Eac.ToString("N2")</td>
                        @if (canSeeRisks)
                        {
                            <td class="num">@f.RiskSummary.ReserveP80.ToString("N2")</td>
                            <td class="num"><strong>@f.Forecast.FinancialResultWithReserve.ToString("N2")</strong></td>
                        }
                        else
                        {
                            <td class="num"><strong>@((f.Forecast.ContractValue - f.Forecast.Eac).ToString("N2"))</strong></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="grid-2 dashboard-grid">
    @if (RolePermissions.CanAccess(roleCode, AppSection.PaymentRequests))
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Заявки, требующие решения</h3>
                <div class="card-actions">
                    <a class="btn btn-outline btn-sm" asp-controller="Requests" asp-action="Index">Открыть все</a>
                </div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Номер</th>
                            <th>Статус</th>
                            <th class="num">К оплате</th>
                            <th>Дата</th>
                            <th>Примечание</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.PendingRequests)
                        {
                            var cls = r.Status == RequestStatus.Blocked ? "badge-danger"
                                : r.Status == RequestStatus.Approved ? "badge-success" : "badge-warn";
                            <tr>
                                <td><strong>@r.Number</strong></td>
                                <td><span class="badge @cls">@RussianLabels.RequestStatusName(r.Status)</span></td>
                                <td class="num">@r.PayableAmount.ToString("N2") @r.Currency</td>
                                <td>@r.PlannedPaymentDate.ToString("dd.MM.yyyy")</td>
                                <td>@(r.BlockReason ?? r.Purpose ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (canSeeRisks)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Сводка по рискам проектов (табл. 1.15–1.18)</h3>
                <div class="card-actions">
                    <a class="btn btn-outline btn-sm" asp-controller="Reports" asp-action="Index">Отчёты и печать</a>
                </div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Проект</th>
                            <th class="num">ΣEMV</th>
                            <th class="num">СКО σ</th>
                            <th class="num">Резерв P80</th>
                            <th class="num">Остат. EMV</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Forecasts)
                        {
                            <tr>
                                <td><strong>@f.Project.Code</strong></td>
                                <td class="num">@f.RiskSummary.TotalEmv.ToString("N2")</td>
                                <td class="num">@f.RiskSummary.Sigma.ToString("N2")</td>
                                <td class="num"><strong>@f.RiskSummary.ReserveP80.ToString("N2")</strong></td>
                                <td class="num">@f.RiskSummary.TotalResidualEmv.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Уведомления и триггеры рисков</h3>
            <form method="post" asp-controller="Dashboard" asp-action="ReadAllNotifications">
                <button type="submit" class="btn btn-outline btn-sm">Прочитать все</button>
            </form>
        </div>
        @if (!Model.Notifications.Any())
        {
            <p class="muted" style="margin:0">Новых уведомлений нет.</p>
        }
        else
        {
            <div class="notification-list">
                @foreach (var n in Model.Notifications)
                {
                    var badge = n.Severity == NotificationSeverity.Critical ? "badge-danger"
                        : n.Severity == NotificationSeverity.Warning ? "badge-warn" : "badge-info";
                    <div style="padding:10px 12px;border:1px solid var(--border);border-radius:11px;background:var(--surface-muted);opacity:@(n.IsRead ? "0.62" : "1")">
                        <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
                            <strong style="font-size:12.5px">@n.Title</strong>
                            <span class="badge @badge">@RussianLabels.SeverityName(n.Severity)</span>
                        </div>
                        <div class="muted" style="margin-top:3px">@n.Message</div>
                    </div>
                }
            </div>
        }
    </div>
</div>
