@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Гость";
    var roleName = User.FindFirst("RoleName")?.Value ?? "";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "ProjectManager";
    var sections = RolePermissions.GetSectionsForRole(roleCode);
    var subtitle = ViewData["Subtitle"] as string ?? "Финансовый контур строительной компании";
    var isHub = ViewData["Hub"] is true;
    var unread = ViewData["UnreadNotifications"] as int? ?? 0;
    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var displayName = nameParts.Length >= 2
        ? string.Join(' ', nameParts.Take(2))
        : fullName;
    var initials = string.Concat(nameParts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials)) { initials = "СФ"; }
    var bellTarget = sections.FirstOrDefault(s => s.Section == AppSection.Dashboard)
                     ?? sections.FirstOrDefault();
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0E2A28" />
    <title>@ViewData["Title"] — ОАО «МАПИД»</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <header class="webbar">
        <a class="brand" asp-controller="Home" asp-action="Index" title="Главное меню">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18"/>
                    <path d="M5 21V8l6-4 6 4v13"/>
                    <path d="M9 21v-4h4v4"/>
                    <path d="M9 10h.01M13 10h.01"/>
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-title">ОАО «МАПИД»</span>
                <span class="brand-sub">@roleName</span>
            </span>
        </a>

        @if (isHub)
        {
            <nav class="webnav" aria-label="Разделы системы">
                @foreach (var sec in sections.Take(4))
                {
                    <a class="webnav-link" asp-controller="@sec.Controller" asp-action="@SectionIcons.Action(sec.Section)">@sec.Title</a>
                }
            </nav>
        }
        else
        {
            <nav class="webnav" aria-label="Разделы системы">
                @foreach (var sec in sections.Take(4))
                {
                    bool isActive = string.Equals(currentController, sec.Controller, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(currentAction, SectionIcons.Action(sec.Section), StringComparison.OrdinalIgnoreCase);
                    <a class="webnav-link @(isActive ? "on" : "")" asp-controller="@sec.Controller"
                       asp-action="@SectionIcons.Action(sec.Section)"
                       aria-current="@(isActive ? "page" : null)">@sec.Title</a>
                }
            </nav>
        }

        <div class="bar-right">
            <span class="role-chip"><span class="status-dot"></span>@roleName</span>
            @if (bellTarget is not null)
            {
                <a class="icon-btn" asp-controller="@bellTarget.Controller" asp-action="@SectionIcons.Action(bellTarget.Section)"
                   title="Уведомления и триггеры рисков" aria-label="Уведомления">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.7 21a2 2 0 0 1-3.4 0"/>
                    </svg>
                    <span class="icon-dot" data-count="@unread"></span>
                </a>
            }
            <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                <button type="submit" class="user-pill" title="Выйти из системы">
                    <span class="avatar avatar-sm">@initials</span>
                    <span class="user-pill-text">
                        <strong>@displayName</strong>
                        <em>@User.Identity?.Name</em>
                    </span>
                </button>
            </form>
        </div>
    </header>

    <main class="content stage">
        @if (!isHub)
        {
            <div class="sec-head">
                <a class="back-btn" asp-controller="Home" asp-action="Index" data-back-link>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
                    Назад <kbd>Esc</kbd>
                </a>
                <div class="sec-titles">
                    <div class="sec-crumb">
                        Главное меню
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                        @ViewData["Title"]
                    </div>
                    <h1 class="sec-title">@ViewData["Title"]</h1>
                    <div class="sec-sub">@subtitle</div>
                </div>
            </div>
        }

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success">
                <span class="alert-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span>@ok</span>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger">
                <span class="alert-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
                </span>
                <span>@err</span>
            </div>
        }

        @RenderBody()
    </main>
</div>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
