@model PaymentRequestsViewModel
@{
    ViewData["Title"] = "Платёжные заявки и акты С-2 / С-3";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var statuses = Enum.GetValues<RequestStatus>();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Фильтр реестра заявок</h3>
        <div class="inline-form">
            <a class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) ? "" : "btn-outline")" asp-controller="Requests" asp-action="Index">Все (@Model.Requests.Count)</a>
            @foreach (var st in statuses)
            {
                var stName = st.ToString();
                <a class="btn btn-sm @(Model.StatusFilter == stName ? "" : "btn-outline")" asp-controller="Requests" asp-action="Index" asp-route-status="@stName">@RussianLabels.RequestStatusName(st)</a>
            }
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Тип / Договор</th>
                    <th>Статья</th>
                    <th class="num">К оплате</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Контроль / ЭЦП</th>
                    <th>Действия по маршруту</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Requests)
                {
                    var badge = r.Status == RequestStatus.Blocked || r.Status == RequestStatus.Rejected ? "badge-danger"
                        : r.Status == RequestStatus.Approved || r.Status == RequestStatus.Executed || r.Status == RequestStatus.Closed ? "badge-success"
                        : "badge-warn";
                    <tr>
                        <td><strong>@r.Number</strong><div class="muted">@r.Purpose</div></td>
                        <td>@RussianLabels.RequestTypeName(r.Type)<div class="muted">@r.Contract?.Number</div></td>
                        <td><code>@r.CostItem?.Code</code></td>
                        <td class="num"><strong>@r.PayableAmount.ToString("N2")</strong> @r.Currency</td>
                        <td>@r.PlannedPaymentDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @badge">@RussianLabels.RequestStatusName(r.Status)</span>
                            @if (r.HasOverdueAdvanceWarning)
                            {
                                <div class="badge badge-warn" style="margin-top:4px">Просрочен аванс!</div>
                            }
                        </td>
                        <td class="muted">
                            @(r.BlockReason ?? r.ReturnOrRejectReason ?? r.EdsSignatureThumbprint ?? "—")
                        </td>
                        <td>
                            @if (r.Status == RequestStatus.Blocked && roleCode == "CEO")
                            {
                                <form method="post" asp-controller="Requests" asp-action="ApproveOverrun" class="inline-form" style="margin-bottom:4px">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="approve" value="true" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input name="reason" placeholder="Обоснование перерасхода" value="Согласовано руководителем" style="width:155px;padding:4px 6px" />
                                    <button type="submit" class="btn btn-warn btn-sm">Согласовать перерасход</button>
                                </form>
                                <form method="post" asp-controller="Requests" asp-action="ApproveOverrun" class="inline-form">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="approve" value="false" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input type="hidden" name="reason" value="Превышен свободный лимит" />
                                    <button type="submit" class="btn btn-danger btn-sm">Отклонить</button>
                                </form>
                            }
                            @if (r.Status == RequestStatus.Blocked && roleCode == "FinancialManager")
                            {
                                <div class="muted" style="margin-bottom:4px">Перерасход UC04 решается Руководителем (WPF)</div>
                                <form method="post" asp-controller="Requests" asp-action="ReturnOrReject" class="inline-form">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="rejectPermanently" value="true" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input type="hidden" name="reason" value="Отклонено: превышен свободный лимит" />
                                    <button type="submit" class="btn btn-danger btn-sm">Отклонить</button>
                                </form>
                            }
                            @if (r.Status is RequestStatus.Returned or RequestStatus.Draft
                                 && roleCode is "ProjectManager" or "ProcurementSpecialist" or "FinancialManager" or "CEO")
                            {
                                <form method="post" asp-controller="Requests" asp-action="Resubmit" class="inline-form">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <button type="submit" class="btn btn-sm">Отправить повторно</button>
                                </form>
                            }
                            @if ((r.Status == RequestStatus.PendingApproval || r.Status == RequestStatus.ApprovedByManagement)
                                 && roleCode is "FinancialManager" or "CEO")
                            {
                                <form method="post" asp-controller="Requests" asp-action="Approve" class="inline-form" style="margin-bottom:4px">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input name="edsThumbprint" value="EDS-2026-BY-DEMO" style="width:130px;padding:4px 6px" />
                                    <button type="submit" class="btn btn-success btn-sm">Согласовать (ЭЦП)</button>
                                </form>
                                <form method="post" asp-controller="Requests" asp-action="ReturnOrReject" class="inline-form">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="rejectPermanently" value="false" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input type="hidden" name="reason" value="Уточнить первичные документы" />
                                    <button type="submit" class="btn btn-outline btn-sm">Вернуть</button>
                                </form>
                            }
                            @if (r.Status == RequestStatus.Approved && roleCode == "Accountant")
                            {
                                <form method="post" asp-controller="Requests" asp-action="Execute" class="inline-form">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input name="paymentOrderNumber" placeholder="№ ПП" value="ПП-@DateTime.Now.ToString("HHmm")" style="width:95px;padding:4px 6px" />
                                    <button type="submit" class="btn btn-sm">Исполнить платёж</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="grid-2">
    @if (roleCode is "ProjectManager" or "ProcurementSpecialist" or "FinancialManager" or "CEO")
    {
        <div class="card">
            <h3 class="card-title" style="margin-bottom:10px">Новая платёжная заявка (проверка лимита, авансов и календаря)</h3>
            @if (!Model.Objects.Any() || !Model.Contracts.Any() || !Model.CostItems.Any())
            {
                <p class="muted">Для создания заявки добавьте хотя бы один проект, объект, договор и статью затрат в базе данных.</p>
            }
            else
            {
            <form method="post" asp-controller="Requests" asp-action="Create" class="form-grid">
                <div class="field">
                    <label>Объект строительства</label>
                    <select name="constructionObjectId">
                        @foreach (var o in Model.Objects)
                        {
                            <option value="@o.Id">@o.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Договор подрядчика/поставщика</label>
                    <select name="contractId">
                        @foreach (var c in Model.Contracts)
                        {
                            <option value="@c.Id">@c.Number — @c.Counterparty</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Статья затрат</label>
                    <select name="costItemId">
                        @foreach (var ci in Model.CostItems)
                        {
                            <option value="@ci.Id">@ci.Code — @ci.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Тип заявки</label>
                    <select name="type">
                        <option value="CurrentPayment">Текущий платёж (CurrentPayment)</option>
                        <option value="Advance">Новый аванс (Advance)</option>
                    </select>
                </div>
                <div class="field">
                    <label>Сумма по акту / счёту (тыс. р.)</label>
                    <input type="number" step="0.01" name="actAmount" value="320.00" required />
                </div>
                <div class="field">
                    <label>Зачёт аванса (тыс. р.)</label>
                    <input type="number" step="0.01" name="advanceOffset" value="0.00" />
                </div>
                <div class="field">
                    <label>Гарант. удержание (тыс. р.)</label>
                    <input type="number" step="0.01" name="retentionAmount" value="0.00" />
                </div>
                <div class="field">
                    <label>Сумма аванса (если Advance)</label>
                    <input type="number" step="0.01" name="amount" value="320.00" />
                </div>
                <div class="field">
                    <label>Валюта</label>
                    <select name="currency">
                        <option value="BYN">BYN</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="RUB">RUB</option>
                    </select>
                </div>
                <div class="field">
                    <label>Плановая дата оплаты</label>
                    <input type="date" name="plannedPaymentDate" value="2026-11-15" required />
                </div>
                <div class="field">
                    <label>Номер документа (С-2 / Счёт)</label>
                    <input name="documentNumber" value="С-2/341" required />
                </div>
                <div class="field">
                    <label>Назначение платежа</label>
                    <input name="purpose" value="Оплата монолитных и фасадных работ" required />
                </div>
                <div>
                    <button type="submit" class="btn">Создать и отправить на проверку</button>
                </div>
            </form>
            }
        </div>
    }

    <div class="card">
        <h3 class="card-title" style="margin-bottom:10px">Реестр актов С-2 и справок С-3 (Sк_опл = Sакт − Aзач − Uудерж)</h3>
        @if (roleCode is "ProjectManager" or "Accountant" or "ProcurementSpecialist")
        {
            @if (!Model.Objects.Any() || !Model.Contracts.Any())
            {
                <p class="muted" style="margin-bottom:12px">Для регистрации акта С-2/С-3 требуются объект строительства и расходный договор.</p>
            }
            else
            {
            <form method="post" asp-controller="Requests" asp-action="CreateAct" class="form-grid" style="margin-bottom:14px">
                <div class="field">
                    <label>Договор</label>
                    <select name="contractId">
                        @foreach (var c in Model.Contracts)
                        {
                            <option value="@c.Id">@c.Number</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Объект</label>
                    <select name="constructionObjectId">
                        @foreach (var o in Model.Objects)
                        {
                            <option value="@o.Id">@o.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Вид документа</label>
                    <select name="documentType">
                        <option value="ActS2">Акт С-2</option>
                        <option value="CertificateS3">Справка С-3</option>
                    </select>
                </div>
                <div class="field">
                    <label>Номер документа</label>
                    <input name="number" value="С-2/129" required />
                </div>
                <div class="field">
                    <label>Сумма акта (Sакт)</label>
                    <input type="number" step="0.01" name="grossAmount" value="420.00" required />
                </div>
                <div class="field">
                    <label>Зачёт аванса (Aзач)</label>
                    <input type="number" step="0.01" name="advanceOffset" value="84.00" />
                </div>
                <div class="field">
                    <label>Удержание (Uудерж)</label>
                    <input type="number" step="0.01" name="retentionAmount" value="21.00" />
                </div>
                <div class="field">
                    <label>Фотофиксация (путь)</label>
                    <input name="photoEvidencePaths" placeholder="photos/obj1_act.jpg" />
                </div>
                <div class="field">
                    <label>Описание выполненных работ</label>
                    <input name="actWorkDescription" value="Кирпичная кладка и монтаж перекрытий" />
                </div>
                <div>
                    <button type="submit" class="btn btn-outline">Зафиксировать акт С-2</button>
                </div>
            </form>
            }
        }
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Номер</th>
                        <th class="num">Sакт</th>
                        <th class="num">Зачёт / Удерж.</th>
                        <th class="num">К оплате Sк_опл</th>
                        <th>Инстр. 53</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Acts)
                    {
                        <tr>
                            <td><strong>@a.Number</strong><div class="muted">@a.ActWorkDescription</div></td>
                            <td class="num">@a.GrossAmount.ToString("N2")</td>
                            <td class="num">@a.AdvanceOffset.ToString("N2") / @a.RetentionAmount.ToString("N2")</td>
                            <td class="num"><strong>@a.NetAmount.ToString("N2")</strong></td>
                            <td>@(a.IsVerifiedByInstruction53 ? "Проверен" : "Нет")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
