@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Гость";
    var roleName = User.FindFirst("RoleName")?.Value ?? "";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — СтройФинРиск (ASP.NET Core 9)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-title">СтройФинРиск</div>
            <div class="brand-sub">ASP.NET Core 9 MVC • Учёт финансов и рисков</div>
        </div>
        <nav class="nav-links">
            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Дашборд</a>
            <a class="nav-link @(currentController == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Проекты и бюджеты</a>
            <a class="nav-link @(currentController == "Requests" ? "active" : "")" asp-controller="Requests" asp-action="Index">Заявки и акты С-2</a>
            <a class="nav-link @(currentController == "Calendar" ? "active" : "")" asp-controller="Calendar" asp-action="Index">Платёжный календарь</a>
            <a class="nav-link @(currentController == "Contracts" ? "active" : "")" asp-controller="Contracts" asp-action="Index">Договоры и авансы</a>
            <a class="nav-link @(currentController == "Risks" ? "active" : "")" asp-controller="Risks" asp-action="Index">Риски и резерв P80</a>
            <a class="nav-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">Отчёты и экспорт</a>
            @if (roleCode is "Admin" or "CEO" or "FinancialManager")
            {
                <a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">Администрирование</a>
            }
        </nav>
        <div class="sidebar-footer">
            <div>API и OpenAPI активны на том же узле:</div>
            <div><a href="/api/health" style="color:#93c5fd">/api/health</a></div>
        </div>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-user">
                <span class="user-pill"><strong>@fullName</strong> · @roleName (@roleCode)</span>
                <a class="btn btn-outline btn-sm" asp-controller="Account" asp-action="Login">Сменить роль</a>
                <form method="post" asp-controller="Account" asp-action="Logout" style="display:inline">
                    <button type="submit" class="btn btn-outline btn-sm">Выйти</button>
                </form>
            </div>
        </header>

        <main class="content">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger">@err</div>
            }
            @RenderBody()
        </main>
    </div>
</div>
</body>
</html>
