<Window x:Class="FinanveManager.WpfClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — СтройФинРиск"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Border Style="{StaticResource CardBorder}" Margin="18" Padding="22">
        <StackPanel>
            <TextBlock Text="СтройФинРиск" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Управление финансами и рисками строительных проектов"
                       FontSize="12" Foreground="#64748B" Margin="0,2,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="Учётная запись (быстрое заполнение)" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
            <ComboBox x:Name="DemoUsersCombo"
                      DisplayMemberPath="Display"
                      SelectionChanged="DemoUsersCombo_OnSelectionChanged"
                      Padding="8,6"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Логин" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginTextBox" Padding="8,7" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Padding="8,7" Margin="0,0,0,10"/>

            <TextBlock Text="Код 2FA (обязателен для роли Администратор: 246810)"
                       FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="TwoFactorTextBox" Padding="8,7" Margin="0,0,0,12"/>

            <Border x:Name="ErrorBanner"
                    Background="#FEE2E2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#991B1B" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <Button x:Name="LoginButton"
                    Content="Войти в систему"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Padding="14,10"
                    Click="LoginButton_OnClick"/>

            <TextBlock Text="Пароль для демонстрационных ролей: StroyFin2026!"
                       FontSize="11" Foreground="#64748B" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
