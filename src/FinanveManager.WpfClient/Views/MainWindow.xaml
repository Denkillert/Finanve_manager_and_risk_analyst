<Window x:Class="FinanveManager.WpfClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СтройФинРиск — Финансы и риски строительных проектов"
        Width="1360"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая боковая навигация (только разрешённые для роли разделы) -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="18,18,18,14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="СтройФинРиск" Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RoleName}" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UserFullName}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,2,0,10" Foreground="#94A3B8" FontSize="11.5">
                            <Run Text="{Binding UserLogin, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding RoleCode, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Content="Обновить данные"
                                Command="{Binding RefreshCommand}"
                                Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0"
                                Padding="10,7" Margin="0,0,0,6" Cursor="Hand"/>
                        <Button x:Name="LogoutButton"
                                Content="Выйти / Сменить роль"
                                Click="LogoutButton_OnClick"
                                Background="Transparent" Foreground="#CBD5E1"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="10,7" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,12">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,10"
                                        Margin="0,0,0,4"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FontSize="13">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Основная рабочая область -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <!-- Верхняя строка заголовка -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="22,13">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DatabaseModeLabel}" Foreground="#1D4ED8" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding SelectedSectionTitle}" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Нижняя строка статуса -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#334155"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Контент активного раздела -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Grid>
                    <!-- 1. Обзор портфеля -->
                    <StackPanel Visibility="{Binding IsDashboardSection, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="5" Margin="0,0,-10,14">
                            <Border Style="{StaticResource KpiCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Контрактная цена" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding KpiContractTotal}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Утверждённый бюджет BAC" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding KpiApprovedBudget}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Свободный лимит Lдост" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding KpiFreeLimit}" FontSize="18" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Резерв рисков P80" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding KpiReserveP80}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Кассовые разрывы (90 дн.)" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding KpiCashGap}" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                Visibility="{Binding IsCeoDashboard, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Прогноз стоимости проектов (метод освоенного объёма EVM + резерв P80, z = 0,84)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Forecasts}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="105"/>
                                        <DataGridTextColumn Header="Проект" Binding="{Binding Name}" Width="240"/>
                                        <DataGridTextColumn Header="Цена V" Binding="{Binding ContractValue, StringFormat=N0}" Width="90"/>
                                        <DataGridTextColumn Header="BAC" Binding="{Binding Bac, StringFormat=N0}" Width="90"/>
                                        <DataGridTextColumn Header="PV" Binding="{Binding Pv, StringFormat=N0}" Width="80"/>
                                        <DataGridTextColumn Header="EV" Binding="{Binding Ev, StringFormat=N0}" Width="80"/>
                                        <DataGridTextColumn Header="AC" Binding="{Binding Ac, StringFormat=N0}" Width="80"/>
                                        <DataGridTextColumn Header="CPI" Binding="{Binding CpiText}" Width="70"/>
                                        <DataGridTextColumn Header="SPI" Binding="{Binding SpiText}" Width="70"/>
                                        <DataGridTextColumn Header="EAC" Binding="{Binding Eac, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Резерв P80" Binding="{Binding ReserveP80, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Фин. рез." Binding="{Binding FinancialResult, StringFormat=N2}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Заявки, требующие решения" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding DashboardPendingRequests}" MaxHeight="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="135"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                                            <DataGridTextColumn Header="К оплате" Binding="{Binding PayableAmount, StringFormat=N2}" Width="85"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding PlannedDate, StringFormat=dd.MM.yyyy}" Width="85"/>
                                            <DataGridTextColumn Header="Примечание" Binding="{Binding NoteText}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Ликвидность и кассовые разрывы (90 дн.)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding DashboardCashDays}" MaxHeight="210">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCashGap}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="День" Binding="{Binding DayIndex}" Width="50"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="88"/>
                                            <DataGridTextColumn Header="Поступ. P" Binding="{Binding Inflows, StringFormat=N0}" Width="75"/>
                                            <DataGridTextColumn Header="Выпл. V" Binding="{Binding Outflows, StringFormat=N0}" Width="75"/>
                                            <DataGridTextColumn Header="Остаток C(t)" Binding="{Binding ClosingBalance, StringFormat=N2}" Width="95"/>
                                            <DataGridTextColumn Header="Разрыв" Binding="{Binding CashGap, StringFormat=N2}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Уведомления и триггеры рисков" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Notifications}" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Уровень" Binding="{Binding SeverityText}" Width="120"/>
                                        <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="260"/>
                                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. Проекты и бюджеты -->
                    <StackPanel Visibility="{Binding IsProjectsSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                Visibility="{Binding CanManageProjectsAndTeam, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Создание нового проекта и назначение руководителя проекта (прораба)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Width="115" Margin="0,0,10,8">
                                        <TextBlock Text="Шифр проекта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectCode}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="250" Margin="0,0,10,8">
                                        <TextBlock Text="Наименование проекта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectName}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="115" Margin="0,0,10,8">
                                        <TextBlock Text="Цена V (тыс. р.)" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectContractValue}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="75" Margin="0,0,10,8">
                                        <TextBlock Text="Валюта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewProjectCurrency}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,8">
                                        <TextBlock Text="Нач. остаток ДС" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectInitialCash}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,8">
                                        <TextBlock Text="Мин. остаток ДС" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectMinCash}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,8">
                                        <TextBlock Text="Дата начала" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectStartDate}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,8">
                                        <TextBlock Text="Дата окончания" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectEndDate}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,8">
                                        <TextBlock Text="Первый объект строительства" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectObjectName}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="190" Margin="0,0,10,8">
                                        <TextBlock Text="Адрес объекта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewProjectObjectAddress}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,10,8">
                                        <TextBlock Text="Назначить руководителя (прораба)" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding ProjectManagerUserLookups}" SelectedItem="{Binding SelectedNewProjectManager}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <Button Content="Создать проект и назначить прораба" Command="{Binding CreateProjectCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                </WrapPanel>

                                <Separator Margin="0,4,0,10" Background="#E2E8F0"/>
                                <TextBlock Text="Добавление объекта строительства и этапа работ (PV) к существующему проекту"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding ProjectLookups}" SelectedItem="{Binding ObjectStageProject}" DisplayMemberPath="Display" Width="210" Padding="6,5" Margin="0,0,8,6"/>
                                    <TextBox Text="{Binding NewObjectName}" Width="180" Padding="6,5" Margin="0,0,8,6" ToolTip="Наименование объекта"/>
                                    <TextBox Text="{Binding NewObjectAddress}" Width="150" Padding="6,5" Margin="0,0,8,6" ToolTip="Адрес"/>
                                    <TextBox Text="{Binding NewStageName}" Width="190" Padding="6,5" Margin="0,0,8,6" ToolTip="Этап работ"/>
                                    <TextBox Text="{Binding NewStagePvInput}" Width="90" Padding="6,5" Margin="0,0,8,6" ToolTip="PV этапа"/>
                                    <Button Content="Добавить объект / этап" Command="{Binding AddObjectStageCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                Visibility="{Binding CanManageProjectsAndTeam, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Команда проекта и закреплённые руководители (прорабы)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <ComboBox ItemsSource="{Binding ProjectLookups}" SelectedItem="{Binding AssignProject}" DisplayMemberPath="Display" Width="220" Padding="6,5" Margin="0,0,8,6"/>
                                    <ComboBox ItemsSource="{Binding AssignableUserLookups}" SelectedItem="{Binding AssignUser}" DisplayMemberPath="Display" Width="260" Padding="6,5" Margin="0,0,8,6"/>
                                    <TextBox Text="{Binding AssignRoleInput}" Width="210" Padding="6,5" Margin="0,0,8,6" ToolTip="Проектная роль"/>
                                    <CheckBox IsChecked="{Binding AssignIsPrimaryManager}" Content="Ответственный прораб / РП" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                    <Button Content="Назначить в проект" Command="{Binding AssignMemberCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,6"/>
                                    <Button Content="Снять выбранное назначение" Command="{Binding RemoveMemberCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding ProjectAssignments}" SelectedItem="{Binding SelectedAssignment}" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Проект" Binding="{Binding ProjectCode}" Width="105"/>
                                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding UserFullName}" Width="200"/>
                                        <DataGridTextColumn Header="Логин" Binding="{Binding UserLogin}" Width="110"/>
                                        <DataGridTextColumn Header="Системная роль" Binding="{Binding SystemRoleName}" Width="190"/>
                                        <DataGridTextColumn Header="Роль в проекте" Binding="{Binding ProjectRole}" Width="210"/>
                                        <DataGridTextColumn Header="Прораб / статус" Binding="{Binding PrimaryMarkText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Витрина свободного лимита vFreeLimit (Lдост = B − O, Oост = O − F)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding FreeLimits}" MaxHeight="230">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Проект" Binding="{Binding ProjectCode}" Width="100"/>
                                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="210"/>
                                        <DataGridTextColumn Header="Статья" Binding="{Binding CostItemCode}" Width="75"/>
                                        <DataGridTextColumn Header="Бюджет B" Binding="{Binding ApprovedBudget, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Обязат. O" Binding="{Binding GrossObligations, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Оплач. F" Binding="{Binding PaidFact, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Заявки Q" Binding="{Binding SubmittedRequests, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Lдост" Binding="{Binding FreeLimit, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Oост" Binding="{Binding ObligationRemainder, StringFormat=N2}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Версии бюджетов (редактируется только Draft)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,8" Visibility="{Binding CanManageBudgets, Converter={StaticResource BoolToVis}}">
                                        <ComboBox ItemsSource="{Binding ProjectLookups}" SelectedItem="{Binding BudgetProject}"
                                                  DisplayMemberPath="Display" Width="210" Padding="6,5" Margin="0,0,8,6"/>
                                        <TextBox Text="{Binding BudgetComment}" Width="210" Padding="6,5" Margin="0,0,8,6"/>
                                        <Button Content="Создать Draft" Command="{Binding CreateBudgetVersionCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <DataGrid ItemsSource="{Binding BudgetVersions}" SelectedItem="{Binding SelectedBudgetVersion}" MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Проект" Binding="{Binding ProjectCode}" Width="105"/>
                                            <DataGridTextColumn Header="Версия" Binding="{Binding VersionNumber}" Width="65"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="105"/>
                                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding CanApproveVersion, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Утвердить выбранную Draft-версию"
                                                Command="{Binding ApproveVersionCommand}"
                                                Style="{StaticResource SuccessButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Лимиты по версиям и статьям" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,8" Visibility="{Binding CanManageBudgets, Converter={StaticResource BoolToVis}}">
                                        <ComboBox ItemsSource="{Binding DraftVersionLookups}" SelectedItem="{Binding SelectedDraftVersionLookup}" DisplayMemberPath="Display" Width="170" Padding="6,5" Margin="0,0,6,6"/>
                                        <ComboBox ItemsSource="{Binding ObjectLookups}" SelectedItem="{Binding NewLimitObject}" DisplayMemberPath="Display" Width="165" Padding="6,5" Margin="0,0,6,6"/>
                                        <ComboBox ItemsSource="{Binding CostItemLookups}" SelectedItem="{Binding NewLimitCostItem}" DisplayMemberPath="Display" Width="150" Padding="6,5" Margin="0,0,6,6"/>
                                        <TextBox Text="{Binding NewLimitAmountInput}" Width="90" Padding="6,5" Margin="0,0,6,6" ToolTip="Сумма лимита (тыс. р.)"/>
                                        <Button Content="Добавить в Draft" Command="{Binding AddDraftLimitCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <DataGrid ItemsSource="{Binding BudgetLimits}" SelectedItem="{Binding SelectedBudgetLimit}" MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Вер." Binding="{Binding VersionNumber}" Width="45"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding VersionStatusText}" Width="95"/>
                                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="180"/>
                                            <DataGridTextColumn Header="Статья" Binding="{Binding CostItemCode}" Width="65"/>
                                            <DataGridTextColumn Header="Лимит" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding CanManageBudgets, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Новый лимит:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding LimitAmountInput}" Width="120" Padding="6,5" Margin="0,0,8,0"/>
                                        <Button Content="Сохранить лимит" Command="{Binding UpdateLimitCommand}" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 3. Платёжные заявки -->
                    <StackPanel Visibility="{Binding IsRequestsSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RequestStatusFilters}"
                                              SelectedItem="{Binding SelectedRequestStatusFilter}" DisplayMemberPath="Title"
                                              Width="180" Padding="6,5"/>
                                    <TextBlock Text="Реестр платёжных заявок" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding PaymentRequests}" SelectedItem="{Binding SelectedRequest}" MaxHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="145"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="125"/>
                                        <DataGridTextColumn Header="Договор" Binding="{Binding ContractNumber}" Width="120"/>
                                        <DataGridTextColumn Header="Статья" Binding="{Binding CostItemCode}" Width="65"/>
                                        <DataGridTextColumn Header="К оплате" Binding="{Binding PayableAmount, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Вал." Binding="{Binding Currency}" Width="50"/>
                                        <DataGridTextColumn Header="Дата" Binding="{Binding PlannedDate, StringFormat=dd.MM.yyyy}" Width="88"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="145"/>
                                        <DataGridTextColumn Header="Контроль / ЭЦП / Примечание" Binding="{Binding NoteText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Карточка выбранной заявки (реквизиты, расчёт Lдост / Oост и история)"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedRequestCardSummary}" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedRequestHistoryText}" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,12,0,0">
                                    <TextBox Text="{Binding ActionReasonInput}" Width="210" Padding="6,5" Margin="0,0,8,6"
                                             ToolTip="Обоснование решения / возврата"
                                             Visibility="{Binding CanApproveRequest, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Согласовать перерасход (CEO)" Command="{Binding ApproveOverrunCommand}"
                                            Style="{StaticResource WarningButton}" Margin="0,0,8,6"
                                            Visibility="{Binding CanApproveOverrun, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Отклонить перерасход" Command="{Binding RejectOverrunCommand}"
                                            Style="{StaticResource DangerButton}" Margin="0,0,8,6"
                                            Visibility="{Binding CanApproveOverrun, Converter={StaticResource BoolToVis}}"/>

                                    <Button Content="Согласовать (ЭЦП)" Command="{Binding ApproveRequestCommand}"
                                            Style="{StaticResource SuccessButton}" Margin="0,0,8,6"
                                            Visibility="{Binding CanApproveRequest, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Вернуть на доработку" Command="{Binding ReturnRequestCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                            Visibility="{Binding CanApproveRequest, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding CanExecutePayment, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding PaymentOrderInput}" Width="105" Padding="6,5" Margin="0,0,8,0"/>
                                        <Button Content="Исполнить платёж (Бухгалтер)" Command="{Binding ExecutePaymentCommand}"
                                                Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}"
                                Visibility="{Binding CanCreateRequest, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Новая платёжная заявка (автоматическая проверка лимита, авансов и календаря)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="230" Margin="0,0,12,8">
                                        <TextBlock Text="Объект строительства" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding ObjectLookups}" SelectedItem="{Binding NewReqObject}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="250" Margin="0,0,12,8">
                                        <TextBlock Text="Договор" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding OutgoingContractLookups}" SelectedItem="{Binding NewReqContract}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="230" Margin="0,0,12,8">
                                        <TextBlock Text="Статья затрат" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding CostItemLookups}" SelectedItem="{Binding NewReqCostItem}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="155" Margin="0,0,12,8">
                                        <TextBlock Text="Тип заявки" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RequestTypes}" SelectedItem="{Binding NewReqType}" DisplayMemberPath="Title" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,8">
                                        <TextBlock Text="Сумма" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewReqAmount}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="80" Margin="0,0,12,8">
                                        <TextBlock Text="Валюта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewReqCurrency}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="115" Margin="0,0,12,8">
                                        <TextBlock Text="Дата (ГГГГ-ММ-ДД)" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewReqDate}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,8">
                                        <TextBlock Text="Документ С-2" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewReqDocNo}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="250" Margin="0,0,12,8">
                                        <TextBlock Text="Назначение" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewReqPurpose}" Padding="6,5"/>
                                    </StackPanel>
                                    <Button Content="Создать и проверить" Command="{Binding CreateRequestCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Этапы и акты С-2 (для прораба / участка) -->
                    <StackPanel Visibility="{Binding IsSiteActsSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Оформление акта сдачи-приёмки С-2 (Sк_опл = Sакт − Aзач − Uудерж)"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="230" Margin="0,0,12,8">
                                        <TextBlock Text="Договор" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding OutgoingContractLookups}" SelectedItem="{Binding NewActContract}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,12,8">
                                        <TextBlock Text="Объект строительства" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding ObjectLookups}" SelectedItem="{Binding NewActObject}" DisplayMemberPath="Display" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,8">
                                        <TextBlock Text="Номер акта" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewActNumber}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,8">
                                        <TextBlock Text="Сумма Sакт" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewActGross}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,8">
                                        <TextBlock Text="Зачёт аванса" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewActOffset}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,8">
                                        <TextBlock Text="Удержание" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewActRetention}" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Width="320" Margin="0,0,12,8">
                                        <TextBlock Text="Описание выполненных работ" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewActDesc}" Padding="6,5"/>
                                    </StackPanel>
                                    <Button Content="Зарегистрировать акт С-2" Command="{Binding CreateActCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Этапы работ на строительных объектах" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding WorkStages}" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="180"/>
                                            <DataGridTextColumn Header="Этап" Binding="{Binding StageName}" Width="170"/>
                                            <DataGridTextColumn Header="План. сроки" Binding="{Binding PeriodText}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Зарегистрированные акты С-2 и С-3" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding Acts}" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="95"/>
                                            <DataGridTextColumn Header="Sакт" Binding="{Binding GrossAmount, StringFormat=N2}" Width="80"/>
                                            <DataGridTextColumn Header="К оплате" Binding="{Binding NetAmount, StringFormat=N2}" Width="85"/>
                                            <DataGridTextColumn Header="Работы" Binding="{Binding ActWorkDescription}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 5. Платёжный календарь -->
                    <StackPanel Visibility="{Binding IsCalendarSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding CalendarProjectLookups}" SelectedItem="{Binding CalendarProject}"
                                              DisplayMemberPath="Display" Width="220" Padding="6,5" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding HorizonOptions}" SelectedItem="{Binding CalendarHorizonDays}"
                                              Width="80" Padding="6,5" Margin="0,0,8,0"/>
                                    <Button Content="Рассчитать" Command="{Binding RefreshCalendarCommand}" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CalendarSummaryText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Поденный остаток C(t) и кассовые разрывы (дефицит выделен цветом)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding CalendarDays}" MaxHeight="440">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCashGap}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="День" Binding="{Binding DayIndex}" Width="55"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                                            <DataGridTextColumn Header="Нач. остаток" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="95"/>
                                            <DataGridTextColumn Header="Поступ. P" Binding="{Binding Inflows, StringFormat=N2}" Width="85"/>
                                            <DataGridTextColumn Header="Выпл. V" Binding="{Binding Outflows, StringFormat=N2}" Width="85"/>
                                            <DataGridTextColumn Header="Кон. C(t)" Binding="{Binding ClosingBalance, StringFormat=N2}" Width="90"/>
                                            <DataGridTextColumn Header="Разрыв" Binding="{Binding CashGap, StringFormat=N2}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="График платежей по договорам" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding ScheduleItems}" SelectedItem="{Binding SelectedScheduleItem}" MaxHeight="380">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding PlannedDate, StringFormat=dd.MM.yyyy}" Width="88"/>
                                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="85"/>
                                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding CanRescheduleCalendar, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Новая дата:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding RescheduleDateInput}" Width="115" Padding="6,5" Margin="0,0,8,0"/>
                                        <Button Content="Перенести платёж" Command="{Binding RescheduleScheduleItemCommand}" Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 6. Договоры, авансы и интеграции -->
                    <StackPanel Visibility="{Binding IsContractsSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Выгрузить проводки для 1С (CSV)"
                                            Click="Export1CButton_OnClick" Style="{StaticResource SecondaryButton}"
                                            Visibility="{Binding CanOffsetAdvance, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Реестр договоров и обязательств" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Contracts}" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="125"/>
                                        <DataGridTextColumn Header="Контрагент" Binding="{Binding Counterparty}" Width="210"/>
                                        <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="90"/>
                                        <DataGridTextColumn Header="Направление" Binding="{Binding DirectionText}" Width="165"/>
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding EffectiveAmount, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Вал." Binding="{Binding Currency}" Width="48"/>
                                        <DataGridTextColumn Header="Обязат. O" Binding="{Binding GrossObligations, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Оплач. F" Binding="{Binding PaidAmount, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Остаток" Binding="{Binding RemainderAmount, StringFormat=N2}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                Visibility="{Binding CanCreateContract, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Регистрация нового договора (Специалист по снабжению)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding ProjectLookups}" SelectedItem="{Binding NewContractProject}" DisplayMemberPath="Display" Width="210" Padding="6,5" Margin="0,0,8,8"/>
                                    <TextBox Text="{Binding NewContractNumber}" Width="115" Padding="6,5" Margin="0,0,8,8" ToolTip="Номер договора"/>
                                    <TextBox Text="{Binding NewContractCounterparty}" Width="190" Padding="6,5" Margin="0,0,8,8" ToolTip="Контрагент"/>
                                    <TextBox Text="{Binding NewContractUnp}" Width="95" Padding="6,5" Margin="0,0,8,8" ToolTip="УНП"/>
                                    <TextBox Text="{Binding NewContractAmount}" Width="105" Padding="6,5" Margin="0,0,8,8" ToolTip="Сумма договора"/>
                                    <TextBox Text="{Binding NewContractSpec}" Width="230" Padding="6,5" Margin="0,0,8,8" ToolTip="Спецификация / предмет"/>
                                    <Button Content="Зарегистрировать договор" Command="{Binding CreateContractCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                Visibility="{Binding CanOffsetAdvance, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Контроль выданных авансов (Aост = A − Aисп, Kисп = Aисп / A)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Advances}" SelectedItem="{Binding SelectedAdvance}" MaxHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Договор" Binding="{Binding ContractNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Источник" Binding="{Binding FundingSource}" Width="160"/>
                                        <DataGridTextColumn Header="Аванс A" Binding="{Binding Amount, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Зачтено" Binding="{Binding UsedAmount, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Остаток Aост" Binding="{Binding Remainder, StringFormat=N2}" Width="95"/>
                                        <DataGridTextColumn Header="Kисп %" Binding="{Binding UtilizationPercent, StringFormat=N1}" Width="70"/>
                                        <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="88"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="{Binding CanOffsetAdvance, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Сумма зачёта:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding AdvanceOffsetInput}" Width="110" Padding="6,5" Margin="0,0,8,0"/>
                                    <Button Content="Зачесть аванс" Command="{Binding OffsetAdvanceCommand}" Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                                    Visibility="{Binding CanImportStatement, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Импорт банковской выписки CSV / MT940 (контроль дублей по BankOperationId)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding StatementContent}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                    <Button Content="Загрузить и сверить выписку" Command="{Binding ImportStatementCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}"
                                    Visibility="{Binding CanImportEstimate, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Импорт сметы и маппинг статей затрат (≥ 95 %)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding EstimateContent}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                    <Button Content="Выполнить маппинг сметы" Command="{Binding ImportEstimateCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 7. Риски и резерв P80 -->
                    <StackPanel Visibility="{Binding IsRisksSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding ProjectLookups}" SelectedItem="{Binding RiskProject}"
                                                  DisplayMemberPath="Display" Width="250" Padding="6,5" Margin="0,0,8,0"/>
                                        <Button Content="Показать проект" Command="{Binding RefreshRisksCommand}" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                    <TextBlock Text="Портфельный анализ рисков и резерв P80" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <UniformGrid Columns="4" Margin="0,0,-10,0">
                                    <Border Style="{StaticResource KpiCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="ΣEMV (ожидаемые потери)" FontSize="11.5" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding RiskSummaryEmv}" FontSize="17" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Портфельное СКО σ" FontSize="11.5" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding RiskSummarySigma}" FontSize="17" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Резерв P80" FontSize="11.5" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding RiskSummaryP80}" FontSize="17" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Остаточный EMV после мер" FontSize="11.5" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding RiskSummaryResidual}" FontSize="17" FontWeight="Bold" Foreground="#065F46"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Матрица вероятности и влияния 5×5 (табл. 1.16, R = p_б × I)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding RiskMatrix}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BackgroundHex}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeaderText}" Foreground="{Binding ForegroundHex}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                                    <TextBlock Text="{Binding CodesText}" Foreground="{Binding ForegroundHex}" FontSize="12" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Реестр рисков проекта" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Risks}" SelectedItem="{Binding SelectedRisk}" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="55"/>
                                        <DataGridTextColumn Header="Событие" Binding="{Binding Event}" Width="260"/>
                                        <DataGridTextColumn Header="Владелец" Binding="{Binding OwnerRole}" Width="105"/>
                                        <DataGridTextColumn Header="p" Binding="{Binding Probability, StringFormat=P0}" Width="50"/>
                                        <DataGridTextColumn Header="Ущерб C" Binding="{Binding MonetaryImpact, StringFormat=N0}" Width="75"/>
                                        <DataGridTextColumn Header="R" Binding="{Binding IntegralScore}" Width="40"/>
                                        <DataGridTextColumn Header="Зона" Binding="{Binding Zone}" Width="100"/>
                                        <DataGridTextColumn Header="EMV" Binding="{Binding Emv, StringFormat=N2}" Width="75"/>
                                        <DataGridTextColumn Header="Остат. EMV" Binding="{Binding ResidualEmv, StringFormat=N2}" Width="80"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Margin="0,10,0,0" Visibility="{Binding CanEditRisks, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Переоценка выбранного риска: p =" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding EditRiskProb}" Width="65" Padding="6,5" Margin="0,0,10,0"/>
                                    <TextBlock Text="Ущерб C =" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding EditRiskImpact}" Width="85" Padding="6,5" Margin="0,0,10,0"/>
                                    <Button Content="Обновить оценку" Command="{Binding UpdateRiskCommand}" Style="{StaticResource PrimaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Торнадо-анализ чувствительности EAC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding Sensitivity}" MaxHeight="200">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Фактор" Binding="{Binding FactorName}" Width="210"/>
                                            <DataGridTextColumn Header="Сдвиг" Binding="{Binding RangeLabel}" Width="90"/>
                                            <DataGridTextColumn Header="ΔEAC" Binding="{Binding ImpactOnEac, StringFormat=N2}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}"
                                    Visibility="{Binding CanEditRisks, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Идентификация нового риска" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <TextBox Text="{Binding NewRiskCode}" Width="70" Padding="6,5" Margin="0,0,8,8"/>
                                        <TextBox Text="{Binding NewRiskEvent}" Width="260" Padding="6,5" Margin="0,0,8,8"/>
                                        <TextBox Text="{Binding NewRiskProb}" Width="65" Padding="6,5" Margin="0,0,8,8"/>
                                        <TextBox Text="{Binding NewRiskImpact}" Width="80" Padding="6,5" Margin="0,0,8,8"/>
                                        <Button Content="Добавить риск" Command="{Binding CreateRiskCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 8. Регламентные отчёты -->
                    <StackPanel Visibility="{Binding IsReportsSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding ReportChoices}" SelectedItem="{Binding SelectedReportChoice}"
                                                  DisplayMemberPath="Title" Width="320" Padding="6,5" Margin="0,0,8,0"/>
                                        <Button Content="Сформировать" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                        <Button Content="Экспорт в CSV" Click="ExportReportCsvButton_OnClick" Style="{StaticResource SuccessButton}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Регламентная отчётность" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ReportSubtitle}" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid x:Name="ReportGrid" ItemsSource="{Binding ReportRows}" MaxHeight="520">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Колонка 1" Binding="{Binding Col1}" Width="115"/>
                                        <DataGridTextColumn Header="Колонка 2" Binding="{Binding Col2}" Width="250"/>
                                        <DataGridTextColumn Header="Колонка 3" Binding="{Binding Col3}" Width="145"/>
                                        <DataGridTextColumn Header="Колонка 4" Binding="{Binding Col4}" Width="155"/>
                                        <DataGridTextColumn Header="Колонка 5" Binding="{Binding Col5}" Width="170"/>
                                        <DataGridTextColumn Header="Колонка 6" Binding="{Binding Col6}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 9. Администрирование (только для Admin) -->
                    <StackPanel Visibility="{Binding IsAdminSection, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Учётные записи пользователей (RBAC, 2FA)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBox Text="{Binding NewUserLogin}" Width="115" Padding="6,5" Margin="0,0,6,6"/>
                                        <TextBox Text="{Binding NewUserFullName}" Width="145" Padding="6,5" Margin="0,0,6,6"/>
                                        <ComboBox ItemsSource="{Binding RoleLookups}" SelectedItem="{Binding NewUserRole}" DisplayMemberPath="Display" Width="180" Padding="6,5" Margin="0,0,6,6"/>
                                        <TextBox Text="{Binding NewUserPassword}" Width="125" Padding="6,5" Margin="0,0,6,6"/>
                                        <Button Content="Создать" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>

                                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" MaxHeight="360">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="105"/>
                                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="185"/>
                                            <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive, Mode=OneWay}" Width="75"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="Включить / отключить выбранного пользователя"
                                            Command="{Binding ToggleUserActiveCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Нормативные правила (НСИ) и курсы НБ РБ" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBox Text="{Binding NewRuleCode}" Width="90" Padding="6,5" Margin="0,0,6,6"/>
                                        <TextBox Text="{Binding NewRuleName}" Width="185" Padding="6,5" Margin="0,0,6,6"/>
                                        <TextBox Text="{Binding NewRuleValue}" Width="165" Padding="6,5" Margin="0,0,6,6"/>
                                        <Button Content="Добавить правило" Command="{Binding AddNormRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>

                                    <DataGrid ItemsSource="{Binding NormRules}" MaxHeight="220" Margin="0,0,0,12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="90"/>
                                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="190"/>
                                            <DataGridTextColumn Header="Значение" Binding="{Binding ValueText}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Курсы валют НБ РБ" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DataGrid ItemsSource="{Binding CurrencyRates}" MaxHeight="135">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" Width="90"/>
                                            <DataGridTextColumn Header="Курс к BYN" Binding="{Binding RateToByn, StringFormat=N4}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 10. Журнал аудита (только для Admin) -->
                    <StackPanel Visibility="{Binding IsAuditSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Неизменяемый журнал аудита операций (AuditLogs)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding AuditLogs}" MaxHeight="560">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Время UTC" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="135"/>
                                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserLogin}" Width="105"/>
                                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="155"/>
                                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="130"/>
                                        <DataGridTextColumn Header="Новое значение" Binding="{Binding NewValue}" Width="210"/>
                                        <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
