<Window x:Class="FinanveManager.WpfClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — СтройФинРиск"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F4F6FB">
    <Border Margin="22" CornerRadius="22" Background="White" BorderBrush="#E5EAF2" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.14" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" CornerRadius="21,21,0,0" Padding="26,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B1224" Offset="0"/>
                        <GradientStop Color="#1B2B52" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource BrushBrandMark}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="M 4 22 L 20 22 M 6 22 L 6 9 L 13 5 L 20 9 L 20 22 M 10 22 L 10 16 L 16 16 L 16 22"
                              Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Margin="10"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="СтройФинРиск" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Управление финансами и рисками строительных проектов"
                                   FontSize="11.5" Foreground="#A9B8D0" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="330"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Форма -->
            <StackPanel Grid.Row="1" Margin="26,22,26,24">
                <Border x:Name="EmptyDbBanner"
                        Background="#EFF6FF"
                        BorderBrush="#D5E5FF"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="База данных пуста (структура таблиц создана, учётные записи отсутствуют). Выполните database/02_seed_data.sql в SSMS или выберите инициализацию:"
                                   Foreground="#1E3A8A" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,9"/>
                        <Button x:Name="InitRolesAdminButton"
                                Content="Создать 7 ролей (табл. 1.8), admin и director (CEO)"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,7"
                                Click="InitRolesAdminButton_OnClick"/>
                        <Button x:Name="InitDemoDataButton"
                                Content="Загрузить контрольные примеры главы 1 (7 ролей + 12 рисков)"
                                Style="{StaticResource PrimaryButton}"
                                Click="InitDemoDataButton_OnClick"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Быстрый вход" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <ComboBox x:Name="DemoUsersCombo"
                          DisplayMemberPath="Display"
                          SelectionChanged="DemoUsersCombo_OnSelectionChanged"
                          Margin="0,0,0,16"/>

                <TextBlock Text="Логин" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox x:Name="LoginTextBox" Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

                <TextBlock Text="Код 2FA (обязателен для роли Администратор: 246810)"
                           FontSize="11.5" Foreground="#64748B" Margin="0,0,0,5"/>
                <TextBox x:Name="TwoFactorTextBox" Margin="0,0,0,14"/>

                <Border x:Name="ErrorBanner"
                        Background="#FEF1F1"
                        BorderBrush="#FBD5D5"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="12,9"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#991B1B" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <Button x:Name="LoginButton"
                        Content="Войти в систему"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Padding="14,11"
                        FontSize="13.5"
                        Click="LoginButton_OnClick"/>

                <TextBlock Text="Пароль: StroyFin2026! · Веб-роли (finmanager, pm, risk) работают в браузере"
                           FontSize="11" Foreground="#94A3B8" Margin="0,14,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
