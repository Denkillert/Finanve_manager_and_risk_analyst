@model ContractsViewModel
@{
    ViewData["Title"] = "Договоры и снабжение";
    ViewData["Subtitle"] = "Материальные заявки прораба, договоры с поставщиками, авансы и интеграции с банком и 1С";
    var roleCode = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var refDate = new DateTime(2026, 11, 10);
    var isSupply = roleCode == "ProcurementSpecialist";
    var isAccountant = roleCode == "Accountant";
}

<div class="page-intro">
    <div>
        <span class="eyebrow">Снабжение и расчёты</span>
        <h2>Материальные заявки и договорной контур</h2>
        <p>Снабженец обрабатывает потребности прораба, подбирает поставщика и оформляет договор. Бухгалтер ведёт выписки, авансы и выгрузки в 1С.</p>
    </div>
    <div class="intro-chips">
        <span class="chip">Заявки на материал: @Model.MaterialRequests.Count</span>
        <span class="chip">Договоры: @Model.Contracts.Count</span>
        <span class="chip">Авансы: @Model.Advances.Count</span>
    </div>
</div>

@if (isSupply)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Заявки прораба на материал</h3>
                <p class="muted card-hint">Снабженец согласует потребность, указывает поставщика, договор и согласованную цену.</p>
            </div>
        </div>

        <div class="supply-grid">
            @if (!Model.MaterialRequests.Any())
            {
                <p class="muted">Заявок на материал пока нет.</p>
            }
            @foreach (var m in Model.MaterialRequests)
            {
                var badge = m.Status switch
                {
                    MaterialRequestStatus.Rejected => "badge-danger",
                    MaterialRequestStatus.Delivered => "badge-success",
                    MaterialRequestStatus.Ordered => "badge-info",
                    MaterialRequestStatus.Approved => "badge-success",
                    _ => "badge-warn"
                };
                <article class="supply-card">
                    <header>
                        <div>
                            <strong>@m.Number</strong>
                            <span class="badge @badge">@RussianLabels.MaterialRequestStatusName(m.Status)</span>
                        </div>
                        <span class="muted">@m.RequiredDate.ToString("dd.MM.yyyy")</span>
                    </header>
                    <h4>@m.MaterialName</h4>
                    <dl class="supply-meta">
                        <div><dt>Объект</dt><dd>@m.ConstructionObject?.Name</dd></div>
                        <div><dt>Количество</dt><dd>@m.Quantity.ToString("N3") @m.Unit</dd></div>
                        <div><dt>Согласовано</dt><dd>@((m.AgreedTotal ?? 0m).ToString("N2")) BYN</dd></div>
                        <div><dt>Статья</dt><dd>@(m.CostItem?.Code ?? "—")</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(m.Purpose))
                    {
                        <p class="muted">@m.Purpose</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(m.SpecificationNotes))
                    {
                        <p class="muted">Требования: @m.SpecificationNotes</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(m.SupplierName))
                    {
                        <p class="supply-supplier">Поставщик: <strong>@m.SupplierName</strong>@(m.AgreedTotal.HasValue ? $" · {m.AgreedTotal.Value:N2} BYN" : "")</p>
                    }

                    @if (m.Status is MaterialRequestStatus.Submitted or MaterialRequestStatus.Approved)
                    {
                        var offers = Model.Suppliers
                            .SelectMany(s => s.Offers
                                .Where(o => !o.IsDeleted && o.IsActive)
                                .Select(o => new { Offer = o, Supplier = s }))
                            .OrderBy(x => x.Offer.UnitPrice)
                            .ToList();
                        var matching = offers
                            .Where(x => x.Offer.MaterialName.Contains(m.MaterialName, StringComparison.OrdinalIgnoreCase)
                                        || m.MaterialName.Contains(x.Offer.MaterialName, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                        var visibleOffers = matching.Any() ? matching : offers;
                        <form method="post" asp-controller="Contracts" asp-action="@(m.Status == MaterialRequestStatus.Submitted ? "ApproveMaterial" : "OrderMaterial")" class="supply-form">
                            <input type="hidden" name="id" value="@m.Id" />
                            <div class="field span-2">
                                <label>Предложение поставщика (сортировка по выгодной цене)</label>
                                <select name="supplierOfferId">
                                    <option value="">— выбрать вручную —</option>
                                    @foreach (var item in visibleOffers)
                                    {
                                        <option value="@item.Offer.Id" selected="@(m.SupplierOfferId == item.Offer.Id)">
                                            @item.Supplier.Name — @item.Offer.MaterialName — @item.Offer.UnitPrice.ToString("N2") BYN / @item.Offer.Unit (@item.Offer.DeliveryDays дн.)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Договор поставки (необязательно)</label>
                                <select name="contractId">
                                    <option value="">— подобрать по поставщику —</option>
                                    @foreach (var c in Model.Contracts.Where(c => c.Direction == ContractDirection.SupplierSubcontractorOutgoing))
                                    {
                                        <option value="@c.Id" selected="@(m.ContractId == c.Id)">@c.Number — @c.Counterparty</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Поставщик вручную</label>
                                <input name="supplierName" value="@m.SupplierName" placeholder="ООО «Поставщик»" />
                            </div>
                            <div class="field">
                                <label>Цена вручную за @m.Unit</label>
                                <input type="number" step="0.01" min="0" name="agreedUnitPrice"
                                       value="@((m.AgreedUnitPrice ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="field span-2">
                                <label>Комментарий</label>
                                <input name="comment" value="@m.SupplyComment" placeholder="Условия поставки, сроки" />
                            </div>
                            <div class="form-actions span-2">
                                <button type="submit" class="btn btn-sm">@(m.Status == MaterialRequestStatus.Submitted ? "Согласовать" : "Заказать у поставщика")</button>
                            </div>
                        </form>
                    }

                    @if (m.Status is MaterialRequestStatus.Approved or MaterialRequestStatus.Ordered or MaterialRequestStatus.Delivered)
                    {
                        if (m.PaymentRequestId.HasValue)
                        {
                            <p class="supply-supplier">Платёжная заявка: <strong>@(m.PaymentRequest?.Number ?? "сформирована")</strong>@(m.PaymentRequest != null ? $" · {m.PaymentRequest.PayableAmount:N2} BYN · {RussianLabels.RequestStatusName(m.PaymentRequest.Status)}" : "")</p>
                        }
                        else
                        {
                            <form method="post" asp-controller="Contracts" asp-action="CreateMaterialPayment" class="inline-form" style="margin-top:8px">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm">Сформировать платёжную заявку</button>
                            </form>
                        }
                    }

                    @if (m.Status == MaterialRequestStatus.Ordered)
                    {
                        <form method="post" asp-controller="Contracts" asp-action="DeliverMaterial" class="inline-form">
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="btn btn-sm">Подтвердить поставку</button>
                        </form>
                    }

                    @if (m.Status is MaterialRequestStatus.Submitted or MaterialRequestStatus.Approved)
                    {
                        <form method="post" asp-controller="Contracts" asp-action="RejectMaterial" class="inline-form supply-reject">
                            <input type="hidden" name="id" value="@m.Id" />
                            <input name="reason" placeholder="Причина возврата прорабу" value="Уточните марку и объём материала" />
                            <button type="submit" class="btn btn-outline btn-sm">Вернуть прорабу</button>
                        </form>
                    }
                </article>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Реестр договоров, доп. соглашений и обязательств</h3>
        @if (roleCode is "Accountant" or "FinancialManager")
        {
            <a class="btn btn-outline btn-sm" asp-controller="Contracts" asp-action="Export1C">Выгрузка для 1С (1CClientBankExchange)</a>
        }
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Контрагент (УНП)</th>
                    <th>Направление</th>
                    <th class="num">Цена с доп. согл.</th>
                    <th class="num">Удержание %</th>
                    <th class="num">Обязат. O / Оплач. F</th>
                    <th class="num">Остаток договора</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Contracts)
                {
                    var gross = c.Obligations.Where(o => !o.IsDeleted).Sum(o => o.GrossAmount);
                    var paid = c.Obligations.Where(o => !o.IsDeleted).Sum(o => o.PaidAmount);
                    var rem = c.EffectiveTotalAmount - gross;
                    <tr>
                        <td><strong>@c.Number</strong><div class="muted">@c.SpecificationNotes</div></td>
                        <td>@c.Counterparty<div class="muted">УНП @c.CounterpartyUnp · до @c.EndDate.ToString("dd.MM.yyyy")</div></td>
                        <td><span class="badge @(c.Direction == ContractDirection.CustomerIncoming ? "badge-success" : "badge-info")">@RussianLabels.ContractDirectionName(c.Direction)</span></td>
                        <td class="num"><strong>@c.EffectiveTotalAmount.ToString("N2")</strong> @c.Currency</td>
                        <td class="num">@c.RetentionPercent.ToString("N1") %</td>
                        <td class="num">@gross.ToString("N2") / @paid.ToString("N2")</td>
                        <td class="num"><strong>@rem.ToString("N2")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (isSupply)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Реестр поставщиков и их предложений</h3>
                <p class="muted card-hint">Снабженец регистрирует, кто что поставляет и по каким ценам. При согласовании заявки выбирается предложение с наиболее выгодной ценой.</p>
            </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Поставщик</th>
                        <th>УНП / контакты</th>
                        <th>Материал</th>
                        <th class="num">Цена, BYN</th>
                        <th>Срок поставки</th>
                        <th>Действует до</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Suppliers.Any())
                    {
                        <tr><td colspan="6" class="muted">Поставщики ещё не зарегистрированы.</td></tr>
                    }
                    @foreach (var s in Model.Suppliers)
                    {
                        var supplierOffers = s.Offers.Where(o => !o.IsDeleted && o.IsActive).OrderBy(o => o.MaterialName).ThenBy(o => o.UnitPrice).ToList();
                        if (!supplierOffers.Any())
                        {
                            <tr>
                                <td><strong>@s.Name</strong></td>
                                <td>УНП @s.Unp<div class="muted">@s.ContactPerson @s.Phone</div></td>
                                <td colspan="4" class="muted">Предложения не добавлены</td>
                            </tr>
                        }
                        @foreach (var o in supplierOffers)
                        {
                            <tr>
                                <td><strong>@s.Name</strong></td>
                                <td>УНП @s.Unp<div class="muted">@s.ContactPerson @s.Phone</div></td>
                                <td>@o.MaterialName<div class="muted">@o.Notes</div></td>
                                <td class="num"><strong>@o.UnitPrice.ToString("N2")</strong> / @o.Unit</td>
                                <td>@o.DeliveryDays дн.</td>
                                <td>@(o.ValidUntil?.ToString("dd.MM.yyyy") ?? "бессрочно")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="grid-2 grid-stack" style="margin-top:14px">
            <form method="post" asp-controller="Contracts" asp-action="CreateSupplier" class="form-grid">
                <h4 class="span-2" style="margin:0">Новый поставщик</h4>
                <div class="field span-2">
                    <label>Наименование организации</label>
                    <input name="name" placeholder="ОАО «Белорусский цементный завод»" required />
                </div>
                <div class="field">
                    <label>УНП</label>
                    <input name="unp" placeholder="700012345" />
                </div>
                <div class="field">
                    <label>Контактное лицо</label>
                    <input name="contactPerson" placeholder="Иванов И.И." />
                </div>
                <div class="field">
                    <label>Телефон</label>
                    <input name="phone" placeholder="+375 (17) 000-00-00" />
                </div>
                <div class="field">
                    <label>E-mail</label>
                    <input name="email" placeholder="supply@example.by" />
                </div>
                <div class="field span-2">
                    <label>Примечание</label>
                    <input name="notes" placeholder="Условия работы, отсрочка" />
                </div>
                <div class="form-actions span-2">
                    <button type="submit" class="btn btn-sm">Добавить поставщика</button>
                </div>
            </form>

            <form method="post" asp-controller="Contracts" asp-action="CreateSupplierOffer" class="form-grid">
                <h4 class="span-2" style="margin:0">Новое предложение поставщика</h4>
                <div class="field span-2">
                    <label>Поставщик</label>
                    <select name="supplierId" required>
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="field span-2">
                    <label>Материал</label>
                    <input name="materialName" placeholder="Плиты перекрытия ПК 60-15-8" required />
                </div>
                <div class="field">
                    <label>Единица измерения</label>
                    <input name="unit" value="шт." required />
                </div>
                <div class="field">
                    <label>Цена за единицу, BYN</label>
                    <input type="number" step="0.01" min="0.01" name="unitPrice" value="100.00" required />
                </div>
                <div class="field">
                    <label>Срок поставки, дней</label>
                    <input type="number" min="1" name="deliveryDays" value="5" />
                </div>
                <div class="field">
                    <label>Действует до</label>
                    <input type="date" name="validUntil" />
                </div>
                <div class="field span-2">
                    <label>Примечание</label>
                    <input name="notes" placeholder="Условия доставки, скидка" />
                </div>
                <div class="form-actions span-2">
                    <button type="submit" class="btn btn-sm">Добавить предложение</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Регистрация договора с поставщиком</h3>
            <span class="muted">Договор заключается с организацией-контрагентом, без привязки к объекту</span>
        </div>
        <form method="post" asp-controller="Contracts" asp-action="CreateContract" class="form-grid">
            <div class="field">
                <label>Номер договора</label>
                <input name="number" value="ПД-2026/19" required />
            </div>
            <div class="field">
                <label>Контрагент</label>
                <input name="counterparty" value="ООО БелСтройПоставка" required />
            </div>
            <div class="field">
                <label>УНП</label>
                <input name="counterpartyUnp" value="192345678" />
            </div>
            <div class="field">
                <label>Направление</label>
                <select name="direction">
                    <option value="SupplierSubcontractorOutgoing">Расходный (подряд / поставка)</option>
                    <option value="CustomerIncoming">Доходный (заказчик / ДДУ)</option>
                </select>
            </div>
            <div class="field">
                <label>Сумма договора</label>
                <input type="number" step="0.01" name="totalAmount" value="1500.00" required />
            </div>
            <div class="field">
                <label>Валюта</label>
                <select name="currency">
                    <option value="BYN">BYN</option>
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="RUB">RUB</option>
                </select>
            </div>
            <div class="field span-2">
                <label>Спецификация / предмет</label>
                <input name="specificationNotes" value="Поставка арматуры и ЖБИ по графику" />
            </div>
            <div class="form-actions span-2">
                <button type="submit" class="btn">Зарегистрировать договор</button>
            </div>
        </form>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Контроль выданных авансов</h3>
        <span class="muted">Aост = A − Aисп, Kисп = Aисп / A × 100 %</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Договор</th>
                    <th>Источник</th>
                    <th class="num">Выдан A</th>
                    <th class="num">Зачтено Aисп</th>
                    <th class="num">Остаток Aост</th>
                    <th class="num">Kисп %</th>
                    <th>Срок возврата/зачёта</th>
                    <th>Зачёт аванса</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Advances)
                {
                    bool overdue = a.IsOverdueAt(refDate);
                    <tr>
                        <td><strong>@a.Contract?.Number</strong></td>
                        <td>@a.FundingSource</td>
                        <td class="num">@a.Amount.ToString("N2")</td>
                        <td class="num">@a.UsedAmount.ToString("N2")</td>
                        <td class="num"><strong>@a.Remainder.ToString("N2")</strong></td>
                        <td class="num">@((a.UtilizationPercent ?? 0m).ToString("N1")) %</td>
                        <td>
                            @a.DueDate.ToString("dd.MM.yyyy")
                            @if (overdue)
                            {
                                <span class="badge badge-danger">Просрочен</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@RussianLabels.AdvanceStatusName(a.Status)</span>
                            }
                        </td>
                        <td>
                            @if (a.Remainder > 0 && roleCode is "Accountant" or "FinancialManager")
                            {
                                <form method="post" asp-controller="Contracts" asp-action="OffsetAdvance" class="inline-form">
                                    <input type="hidden" name="advanceId" value="@a.Id" />
                                    <input type="number" step="0.01" name="offsetAmount" value="50.00" style="width:90px;padding:4px 6px" />
                                    <button type="submit" class="btn btn-outline btn-sm">Зачесть</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (isAccountant)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Бухгалтерская отчётность и выгрузки</h3>
                <p class="muted card-hint">Формы построены по Закону № 57-З, Постановлению Минфина № 102 и Постановлению МАиС № 29.</p>
            </div>
        </div>
        <div class="report-links">
            <a class="report-link" asp-controller="Contracts" asp-action="ExportAccounting" asp-route-report="balance">
                <strong>Бухгалтерский баланс (форма 1)</strong>
                <span>Активы, пассивы, ОСВ и движение денежных средств</span>
            </a>
            <a class="report-link" asp-controller="Contracts" asp-action="ExportAccounting" asp-route-report="pnl">
                <strong>Отчёт о прибылях и убытках (форма 2)</strong>
                <span>Выручка, себестоимость, налог на прибыль</span>
            </a>
            <a class="report-link" asp-controller="Contracts" asp-action="ExportAccounting" asp-route-report="vat">
                <strong>Реестр НДС</strong>
                <span>Обороты и суммы налога за период</span>
            </a>
            <a class="report-link" asp-controller="Contracts" asp-action="ExportAccounting" asp-route-report="documents">
                <strong>Реестр первичных документов</strong>
                <span>Акты С-2/С-3, счета, договоры (ст. 10 Закона № 57-З)</span>
            </a>
            <a class="report-link" asp-controller="Contracts" asp-action="ExportAccounting" asp-route-report="debts">
                <strong>Дебиторская и кредиторская задолженность</strong>
                <span>Инвентаризация расчётов и просроченные остатки</span>
            </a>
            <a class="report-link" asp-controller="Contracts" asp-action="Export1C">
                <strong>Выгрузка в 1С</strong>
                <span>Формат 1CClientBankExchange (.txt)</span>
            </a>
        </div>
    </div>

    <div class="grid-2">
        <div class="card">
            <h3 class="card-title" style="margin-bottom:8px">Импорт банковской выписки</h3>
            <p class="muted card-hint">CSV или MT940. Дубли отсекаются по BankOperationId.</p>
            @if (!string.IsNullOrEmpty(Model.ImportReportSummary))
            {
                <div class="alert alert-info">@Model.ImportReportSummary</div>
            }
            <form method="post" asp-controller="Contracts" asp-action="ImportStatement">
                <div class="field" style="margin-bottom:8px">
                    <label>Имя файла</label>
                    <input name="fileName" value="bank_statement_2026_11_10.csv" />
                </div>
                <div class="field" style="margin-bottom:10px">
                    <label>Содержимое выписки (с заголовком)</label>
                    <textarea name="content" rows="5">BankOperationId;Date;Amount;Currency;Counterparty;RequestNumber;Purpose;OrderNo
OP-2026-9001;2026-11-10;850.00;BYN;ОАО Белорусский цементный завод;ЗП-20261110-0003;Оплата по акту С-2 № 18;ПП-103</textarea>
                </div>
                <button type="submit" class="btn">Загрузить и сверить выписку</button>
            </form>
        </div>

        <div class="card">
            <h3 class="card-title" style="margin-bottom:8px">Контрольная информация</h3>
            <ul class="info-list">
                <li><strong>Первичный документ</strong> должен содержать обязательные реквизиты по ст. 10 Закона № 57-З.</li>
                <li><strong>Формы С-2 и С-3</strong> утверждены Постановлением МАиС от 20.07.2018 № 29.</li>
