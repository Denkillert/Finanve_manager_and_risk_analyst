@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Авторизация — СтройФинРиск</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<div class="login-shell">
    <div class="card">
        <h2 style="margin-top:0">Вход в систему «СтройФинРиск»</h2>
        <p class="muted">Интерфейс и доступные разделы автоматически настраиваются под вашу роль.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" asp-controller="Account" asp-action="Login">
            <div class="field" style="margin-bottom:10px">
                <label for="Login">Логин</label>
                <input id="Login" name="Login" value="@Model.Login" autocomplete="username" required />
            </div>
            <div class="field" style="margin-bottom:10px">
                <label for="Password">Пароль</label>
                <input id="Password" name="Password" type="password" value="@Model.Password" autocomplete="current-password" required />
            </div>
            <div class="field" style="margin-bottom:14px">
                <label for="TwoFactorCode">Код 2FA (для <code>admin</code>: <code>246810</code>)</label>
                <input id="TwoFactorCode" name="TwoFactorCode" value="@Model.TwoFactorCode" placeholder="Только для администратора" />
            </div>
            <button type="submit" class="btn" style="width:100%">Войти</button>
        </form>
        <p class="muted" style="margin-top:12px">
            Демонстрационный пароль для всех ролей: <code>StroyFin2026!</code>
        </p>
    </div>

    <div class="card">
        <h3 style="margin-top:0">Учётные записи по ролям</h3>
        <p class="muted">Нажмите на роль, чтобы подставить её логин в форму входа:</p>
        <div class="demo-grid">
            @foreach (var u in Model.DemoUsers)
            {
                <button type="button" class="demo-btn"
                        onclick="fillLogin('@u.Login', @(u.Requires2Fa ? "'246810'" : "''"))">
                    <div style="font-weight:700">@u.RoleName</div>
                    <div class="muted">@u.FullName</div>
                    <div style="margin-top:4px;font-size:11.5px">
                        <code>@u.Login</code> · <span class="badge badge-info">@u.RoleCode</span>
                        @if (u.Requires2Fa)
                        {
                            <span class="badge badge-warn">2FA</span>
                        }
                    </div>
                </button>
            }
        </div>
    </div>
</div>
<script>
function fillLogin(login, tfa) {
    document.getElementById('Login').value = login;
    document.getElementById('Password').value = 'StroyFin2026!';
    document.getElementById('TwoFactorCode').value = tfa;
}
</script>
</body>
</html>
